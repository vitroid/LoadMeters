#!/bin/sh
# chkconfig: 2345 90 10
# description: DiskReporter NFS/RAID HTTP API
### BEGIN INIT INFO
# Provides:          diskreporter
# Required-Start:    $network
# Required-Stop:     $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: DiskReporter
### END INIT INFO

DAEMON=/usr/local/bin/diskreporter
[ -x "$DAEMON" ] || DAEMON=/usr/bin/diskreporter
PIDFILE=/var/run/diskreporter.pid
LOGFILE=/var/log/diskreporter.log

start() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "diskreporter already running"
        return 0
    fi
    echo "Starting diskreporter"
    nohup "$DAEMON" >>"$LOGFILE" 2>&1 &
    echo $! > "$PIDFILE"
}

stop() {
    if [ -f "$PIDFILE" ]; then
        echo "Stopping diskreporter"
        kill "$(cat "$PIDFILE")" 2>/dev/null || true
        rm -f "$PIDFILE"
    fi
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "running pid $(cat "$PIDFILE")"
        else
            echo "stopped"
            exit 3
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
